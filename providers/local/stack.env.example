# What the local stack runs with: copy it outside the repo, fill it in, and keep it readable by you only. The
# compose file reads the first block (--env-file); the console reads all of it (README.md, "Setting it up").

# For compose, for the databases the installation runs (postgres.yml, mongo.yml): leave out a database's lines when
# it runs no such database. Each root password also goes in the secret store, as db-root/postgres and db-root/mongo.
WOODSHED_LOCAL_DATA_DIR=/var/lib/woodshed/data
WOODSHED_LOCAL_PG_ROOT_PASSWORD=
WOODSHED_LOCAL_MONGO_ROOT_PASSWORD=
# Where the machine itself reaches Postgres and Mongo, on its loopback only. Change them if a database of your own
# already has 5432 or 27017; sessions use the network, not these.
WOODSHED_LOCAL_PG_PORT=5432
WOODSHED_LOCAL_MONGO_PORT=27017

# For the console, on the local provider.
WOODSHED_PROVIDER=local
WOODSHED_STATE_DIR=/var/lib/woodshed/console
WOODSHED_REPO=your-org/your-repo
# Optional: what the console calls itself, on its pages, the installed app and its GitHub comments. Default Woodshed.
# WOODSHED_CONSOLE_NAME=Acme Woodshed
# Optional: the avatar menu's links to the repo's own GitHub Actions workflows, as label=file.yml pairs.
# WOODSHED_ACTIONS_WORKFLOWS=Deploy=deploy.yml
# The repo's env files as secret=path pairs, and the ones its databases' commands read (the project file's envFiles, each database's envFiles).
WOODSHED_ENV_FILES=app-env=app/.env
WOODSHED_DB_ENV_SECRETS=app-env
# Optional: secrets the repo's installs read, as secret=VARIABLE pairs: each reaches a session in that variable.
# WOODSHED_INSTALL_SECRET_PAIRS=registry-token=REGISTRY_TOKEN
# Optional: a folder of <owner>/<name>.yaml project files, each for a repo with no .woodshed/project.yaml of its own
# (README.md, "Project files the installation supplies").
# WOODSHED_PROJECT_FILES_DIR=/var/lib/woodshed/project-files
WOODSHED_PUBLIC_URL=http://localhost:7690
WOODSHED_IMAGE=woodshed-session
WOODSHED_SESSION_ENV_FILE=/var/lib/woodshed/session-env.json
WOODSHED_LOCAL_SECRETS_DIR=/var/lib/woodshed/secrets
# The key its files are sealed with, outside that folder: `secret.mjs new-key` makes it. Back it up apart from the folder.
WOODSHED_LOCAL_SECRETS_KEY_FILE=/var/lib/woodshed/secrets.key
WOODSHED_LOCAL_HOMES_DIR=/var/lib/woodshed/homes
WOODSHED_LOCAL_DOCKER_NETWORK=woodshed
# Each session's own copy of each database: Postgres's two lines with postgres.yml, Mongo's with mongo.yml (which
# needs Postgres). Leave out a database the installation does not run, and both for none.
WOODSHED_LOCAL_DB_POSTGRES_HOST=postgres
WOODSHED_LOCAL_DB_POSTGRES_ROOT_USER=postgres
WOODSHED_LOCAL_DB_MONGO_HOST=mongo:27017

# The GitHub App. Its key goes on the Secrets page, into WOODSHED_LOCAL_SECRETS_DIR.
WOODSHED_GITHUB_APP_ID=
WOODSHED_GITHUB_APP_INSTALLATION_ID=
# Where sessions reach the console's session API: an address of this machine that containers on the woodshed network
# can reach, such as the network's gateway (docker network inspect woodshed).
WOODSHED_SESSION_API_HOST=

# Webhooks, with a proxy in front of the receiver at this public address. Leave the port empty to poll GitHub instead.
WOODSHED_LOCAL_WEBHOOK_PORT=
WOODSHED_LOCAL_WEBHOOK_URL=
